{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hoanganhduc/coding-system-rebuild/system/software/platform-lock.schema.json",
  "title": "Coding System Ubuntu platform lock",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "host",
    "qualification",
    "manifests",
    "artifacts",
    "cli_versions",
    "unresolved"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": 1},
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version_id", "architecture", "platform"],
      "properties": {
        "id": {"const": "ubuntu"},
        "version_id": {"const": "24.04"},
        "architecture": {"enum": ["amd64", "arm64"]},
        "platform": {"enum": ["linux/amd64", "linux/arm64"]}
      }
    },
    "qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "evidence"],
      "properties": {
        "state": {"enum": ["qualified", "pending-clean-host"]},
        "evidence": {"type": "string", "minLength": 1}
      }
    },
    "manifests": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/fileDigest"}
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/artifact"}
    },
    "cli_versions": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "reason"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "status": {"enum": ["not-applicable", "unverified-artifact"]},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "fileDigest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^(?!/)(?!.*\\.\\.).+$"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "url", "sha256", "format", "evidence"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "version": {"type": "string", "minLength": 1},
        "url": {"type": "string", "pattern": "^https://"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "format": {"enum": ["binary", "tar.gz", "tar.xz", "zip", "apt-key", "apt-source"]},
        "evidence": {"type": "string", "minLength": 1}
      }
    }
  }
}
