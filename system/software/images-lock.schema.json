{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hoanganhduc/coding-system-rebuild/system/software/images-lock.schema.json",
  "title": "Coding System immutable OCI image lock",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "supported_platforms", "resolved_at", "resolution_method", "images"],
  "properties": {
    "schema_version": {"const": 1},
    "supported_platforms": {
      "type": "array",
      "const": ["linux/amd64", "linux/arm64"]
    },
    "resolved_at": {"type": "string", "format": "date-time"},
    "resolution_method": {"type": "string", "minLength": 1},
    "images": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "roles", "repository", "reference", "index_digest", "platforms", "evidence"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "roles": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "repository": {"type": "string", "minLength": 1},
          "reference": {"type": "string", "pattern": "^[^\\s@]+@sha256:[0-9a-f]{64}$"},
          "index_digest": {"$ref": "#/$defs/digest"},
          "platforms": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": {"enum": ["linux/amd64", "linux/arm64"]},
            "additionalProperties": {"$ref": "#/$defs/digest"}
          },
          "evidence": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
