{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hoanganhduc/coding-system-rebuild/schema/python-closure-lock-v2.json",
  "title": "Coding system Python wheel closure lock",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "platform",
    "python",
    "qualification",
    "wheelhouseManifestSha256",
    "environments"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "schema": {"const": "coding-system.python-closure/v2"},
    "platform": {
      "enum": ["ubuntu-24.04-amd64", "ubuntu-24.04-arm64"]
    },
    "python": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implementation", "version"],
      "properties": {
        "implementation": {"const": "cpython"},
        "version": {"const": "3.12"}
      }
    },
    "qualification": {"$ref": "#/$defs/qualification"},
    "wheelhouseManifestSha256": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "environments": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspace",
        "shared",
        "docling-cpu",
        "lean-explore",
        "getscipapers",
        "aider",
        "modal",
        "course-management"
      ],
      "properties": {
        "workspace": {"$ref": "#/$defs/environment"},
        "shared": {"$ref": "#/$defs/environment"},
        "docling-cpu": {"$ref": "#/$defs/environment"},
        "lean-explore": {"$ref": "#/$defs/environment"},
        "getscipapers": {"$ref": "#/$defs/environment"},
        "aider": {"$ref": "#/$defs/environment"},
        "modal": {"$ref": "#/$defs/environment"},
        "course-management": {"$ref": "#/$defs/environment"}
      }
    }
  },
  "$defs": {
    "qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "blockers"],
      "properties": {
        "state": {
          "enum": ["pending-artifacts", "partial", "qualified"]
        },
        "blockers": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["installPath", "profile", "qualification", "manifestSha256", "artifacts"],
      "properties": {
        "installPath": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._/-]+$"
        },
        "profile": {"enum": ["default", "cpu-only"]},
        "qualification": {"$ref": "#/$defs/qualification"},
        "manifestSha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        },
        "artifacts": {
          "type": "array",
          "items": {"$ref": "#/$defs/artifact"}
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "filename",
        "tags",
        "sha256"
      ],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "filename": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.+!-]*\\.whl$"
        },
        "tags": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_]+-[A-Za-z0-9_]+-[A-Za-z0-9_.]+$"
          }
        },
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
