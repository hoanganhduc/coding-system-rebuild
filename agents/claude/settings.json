{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_DISABLE_ADAPTIVE_THINKING": "1",
    "CLAUDE_CODE_SUBPROCESS_ENV_SCRUB": "0",
    "MAX_THINKING_TOKENS": "63999"
  },
  "includeGitInstructions": false,
  "permissions": {
    "allow": [
      "Read({{ HOME }}/VNU-HUS/**)",
      "Read({{ HOME }}/course_management_toolkit/**)",
      "Read({{ HOME }}/.claude/projects/**)",
      "Read({{ HOME }}/.claude/settings.json)",
      "Read({{ HOME }}/.claude/settings.local.json)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(diff:*)",
      "Bash(wc:*)",
      "Bash(git:*)",
      "Bash(bash -n:*)"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/)",
      "Bash(rm -rf /home)",
      "Bash(rm -rf /home/)",
      "Bash(rm -rf $HOME)",
      "Bash(rm -rf $HOME/)",
      "Bash(rm -rf .)",
      "Bash(rm -rf ./)",
      "Bash(rm -rf ..)",
      "Bash(rm -rf ../)",
      "Bash(rm --recursive --force /)",
      "Bash(rm -r -f /)",
      "Bash(mkfs*)",
      "Bash(dd if=* of=/dev/*)",
      "Bash(git push --force origin main)",
      "Bash(git push --force origin master)",
      "Bash(git push --force-with-lease origin main)",
      "Bash(git push --force-with-lease origin master)",
      "Bash(git reset --hard*)",
      "Edit({{ HOME }}/.claude/secrets.json)",
      "Edit({{ HOME }}/.claude/.credentials.json)",
      "Edit(/**/.env)"
    ],
    "defaultMode": "bypassPermissions"
  },
  "hooks": {
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/post-compact-context.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/self-improvement/error-detector.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/hooks/context-monitor.js",
            "timeout": 3
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/pre-compact-guard.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/safety-check.sh",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/hooks/prompt-guard.js",
            "timeout": 3
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "find /tmp -maxdepth 1 \\( -name .claude-session-titled-\\* -o -name claude-ctx-\\*.json -o -name claude-ctx-alert-\\*.json -o -name claude-statusline-debug-\\*.jsonl -o -name claude-sess-\\*-git-baseline.txt \\) -mtime +1 -delete 2>/dev/null; tail -100 /tmp/claude-compact.log > /tmp/claude-compact.log.tmp 2>/dev/null && mv /tmp/claude-compact.log.tmp /tmp/claude-compact.log 2>/dev/null; true",
            "timeout": 3
          },
          {
            "type": "command",
            "command": "bash ~/.openclaw/workspace/scripts/capture-session-git.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.openclaw/workspace/scripts/check-rebuild-plan.sh",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"/usr/bin/python3\" \"{{ HOME }}/.local/share/ai-agents-skills/runtime/workspace/skills/autonomous-research-loop-runtime/autonomous_research_loop_runtime.py\" hook-check"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/self-improvement/activator.sh",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "disableSkillShellExecution": true,
  "statusLine": {
    "type": "command",
    "command": "node ~/.claude/hooks/statusline.js",
    "refreshInterval": 10
  },
  "enabledPlugins": {
    "lean4@lean4-skills": true
  },
  "extraKnownMarketplaces": {
    "lean4-skills": {
      "source": {
        "source": "github",
        "repo": "cameronfreer/lean4-skills"
      },
      "autoUpdate": true
    }
  },
  "feedbackSurveyRate": 0,
  "alwaysThinkingEnabled": true,
  "effortLevel": "xhigh",
  "tui": "fullscreen",
  "showThinkingSummaries": true,
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "switchModelsOnFlag": true,
  "remoteControlAtStartup": false,
  "agentPushNotifEnabled": true,
  "model": "claude-fable-5-1"
}
