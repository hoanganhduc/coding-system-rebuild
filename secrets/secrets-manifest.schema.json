{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coding-system.invalid/schema/secrets-manifest.v2.json",
  "title": "Coding System Secrets Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "entry_defaults", "dir_perms", "entries"],
  "properties": {
    "schema": {"const": "coding-system.secrets-manifest.v2"},
    "entry_defaults": {"$ref": "#/$defs/classification"},
    "dir_perms": {
      "type": "object",
      "additionalProperties": {"type": "string", "pattern": "^0[0-7]{3}$"}
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "mode", "required", "feature", "obtain"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{7,127}$"},
          "path": {"type": "string", "minLength": 1},
          "mode": {"type": "string", "pattern": "^0[0-7]{3}$"},
          "required": {"type": "boolean"},
          "feature": {"type": "string"},
          "obtain": {"type": "string"},
          "exclude": {"type": "array", "items": {"type": "string"}},
          "classification": {"enum": ["authority", "projection", "session", "private-state"]},
          "authority": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{7,127}$"},
          "portability": {"enum": ["portable", "reauth-required", "machine-bound", "regenerated"]},
          "backup": {"type": "boolean"},
          "legacy_import": {
            "description": "Fail-closed synthesis strategy allowed only for a required archived entry when importing a historical ZIP.",
            "enum": ["generated", "destination-authority"]
          },
          "capture": {
            "description": "Capture mechanism. sqlite-backup creates one transactionally consistent image and never copies a live WAL family.",
            "enum": ["regular", "sqlite-backup"]
          }
        },
        "allOf": [
          {
            "if": {"required": ["legacy_import"]},
            "then": {
              "properties": {
                "required": {"const": true},
                "backup": {"const": true}
              }
            }
          },
          {
            "if": {
              "properties": {
                "legacy_import": {"const": "destination-authority"}
              },
              "required": ["legacy_import"]
            },
            "then": {
              "properties": {
                "classification": {"const": "authority"}
              }
            }
          },
          {
            "if": {
              "properties": {
                "capture": {"const": "sqlite-backup"}
              },
              "required": ["capture"]
            },
            "then": {
              "properties": {
                "mode": {"const": "0600"},
                "backup": {"const": true},
                "path": {
                  "pattern": "^[^*?\\[]+\\.(?:db|sqlite|sqlite3)$"
                }
              }
            }
          }
        ],
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "portability", "backup"],
      "properties": {
        "classification": {"enum": ["authority", "projection", "session", "private-state"]},
        "portability": {"enum": ["portable", "reauth-required", "machine-bound", "regenerated"]},
        "backup": {"type": "boolean"}
      }
    }
  }
}
