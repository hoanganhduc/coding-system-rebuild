{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coding-system.invalid/schema/escrow-generation.v1.json",
  "title": "Coding System Immutable 2-of-4 Escrow Generation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "generation_id",
    "created_at",
    "threshold",
    "shares",
    "master_key_sha256",
    "share_records"
  ],
  "properties": {
    "schema": {"const": "coding-system.escrow-generation.v1"},
    "generation_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{7,127}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "threshold": {"const": 2},
    "shares": {"const": 4},
    "master_key_sha256": {"$ref": "#/$defs/sha256"},
    "share_records": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["index", "file", "sha256"],
        "properties": {
          "index": {"type": "integer", "minimum": 1, "maximum": 4},
          "file": {"type": "string", "pattern": "^share-0[1-4]\\.txt$"},
          "sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
