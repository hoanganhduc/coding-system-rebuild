{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coding-system.invalid/schema/recovery-set.v2.json",
  "title": "Coding System Recovery Set",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "set_id",
    "created_at",
    "components",
    "escrow_generation",
    "secrets_manifest",
    "artifacts",
    "owner_data"
  ],
  "properties": {
    "schema": {"const": "coding-system.recovery-set.v2"},
    "set_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{7,127}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "components": {
      "type": "object",
      "additionalProperties": true,
      "required": ["coding-system-rebuild"],
      "properties": {
        "coding-system-rebuild": {
          "type": "object",
          "additionalProperties": false,
          "required": ["commit"],
          "properties": {
            "commit": {
              "type": "string",
              "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
            }
          }
        }
      }
    },
    "escrow_generation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generation_id", "file", "manifest_sha256"],
      "properties": {
        "generation_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{7,127}$"},
        "file": {"const": "escrow-generation.json"},
        "manifest_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "secrets_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "sha256"],
      "properties": {
        "schema": {"const": "coding-system.secrets-manifest.v2"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "bootstrap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "sha256", "size"],
      "properties": {
        "file": {"const": "restore-ubuntu.sh"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size": {"type": "integer", "minimum": 1, "maximum": 1048576}
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keys", "secrets", "private_state"],
      "properties": {
        "keys": {"$ref": "#/$defs/artifact"},
        "secrets": {"$ref": "#/$defs/artifact"},
        "private_state": {"$ref": "#/$defs/artifact"}
      }
    },
    "owner_data": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/owner_data"}
      ]
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "sha256", "size"],
      "properties": {
        "file": {"enum": ["keys.json.gpg", "secrets.tar.gpg", "private-state.tar.gpg"]},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size": {"type": "integer", "minimum": 1, "maximum": 2147483648}
      }
    },
    "owner_data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "sha256",
        "size",
        "openclaw_version",
        "requirement",
        "created_at",
        "source_state_hmac_sha256",
        "capture_policy"
      ],
      "properties": {
        "file": {
          "type": "string",
          "pattern": "^openclaw-private-[0-9]{8}T[0-9]{6}Z\\.tar\\.gz\\.gpg$"
        },
        "sha256": {"$ref": "#/$defs/sha256"},
        "size": {"type": "integer", "minimum": 1, "maximum": 8589934592},
        "openclaw_version": {
          "type": "string",
          "pattern": "^[0-9A-Za-z][0-9A-Za-z.+~_-]{0,127}$"
        },
        "requirement": {
          "enum": ["agent-private-capability", "history-only"]
        },
        "created_at": {"type": "string", "format": "date-time"},
        "source_state_hmac_sha256": {"$ref": "#/$defs/sha256"},
        "capture_policy": {
          "enum": ["fresh-native-snapshot", "reviewed-prebuilt-override"]
        }
      }
    }
  }
}
